import CAS.Continuum.Quadrature.Legendre.RootCertificates

/-!
# Certified Legendre roots for orders five through ten

Generated by `scripts/generate-legendre-root-data.py`, which proposes the brackets by
rational bisection. For each order `n` from five to ten the file lists the monic Legendre
polynomial of degree `n` as a sparse rational polynomial, `n` certified root brackets of
width at most `2⁻⁹⁹` in ascending order, and six lemmas: validity of each bracket,
disjointness and order, containment in `(-1, 1)`, monicity, degree, and vanishing of the
moments below `n`. Validity, order, containment and moments are checked by kernel evaluation
(`decide +kernel`), monicity and degree by `norm_num`. For order five these are
`five_valid`, `five_ordered`, `five_interior`, `five_monic`, `five_degree` and
`five_moments`, and they feed `RootCertificates.rule` to give `fiveGaussian : Rule 5`, with
`five_nodes_mem` placing each node in its bracket. Orders six to ten follow the same
pattern, so the individual lemmas carry no docstrings. `StoredRule.ideal_nodal_eq`
identifies the nodal polynomial of each rule with the monic Legendre polynomial.
-/

namespace Quadrature.LegendreRootData

open Polynomial
open CAS.Polynomial
open CAS.Polynomial.RealRoot
open CAS.Continuum.Legendre
open RootCertificates

/-- Monic degree-5 polynomial, identified by its checked vanishing moments. -/
def fivePolynomial : Sparse.Univariate :=
  [(1, fun _ => 5),
   (-10 / 9, fun _ => 3),
   (5 / 21, fun _ => 1)]

/-- Disjoint brackets in ascending node order, each of width at most `2⁻⁹⁹`. -/
def fiveBrackets : Fin 5 → RootBracket :=
  ![
    ⟨CAS.Continuum.RationalInterval.ofBounds
      (-1148719425618871857555263390794 / 1267650600228229401496703205376)
      (-1148719425618871857555263390793 / 1267650600228229401496703205376)
      (by norm_num), .increasing⟩,
    ⟨CAS.Continuum.RationalInterval.ofBounds
      (-682590944159949762131801328079 / 1267650600228229401496703205376)
      (-682590944159949762131801328078 / 1267650600228229401496703205376)
      (by norm_num), .decreasing⟩,
    ⟨CAS.Continuum.RationalInterval.ofBounds
      (-1 / 1267650600228229401496703205376)
      (1 / 1267650600228229401496703205376)
      (by norm_num), .increasing⟩,
    ⟨CAS.Continuum.RationalInterval.ofBounds
      (682590944159949762131801328078 / 1267650600228229401496703205376)
      (682590944159949762131801328079 / 1267650600228229401496703205376)
      (by norm_num), .decreasing⟩,
    ⟨CAS.Continuum.RationalInterval.ofBounds
      (1148719425618871857555263390793 / 1267650600228229401496703205376)
      (1148719425618871857555263390794 / 1267650600228229401496703205376)
      (by norm_num), .increasing⟩]

set_option maxRecDepth 10000 in
set_option maxHeartbeats 8000000 in
-- Kernel evaluation of the `valid` check for each of the five brackets of `fivePolynomial`.
theorem five_valid (i : Fin 5) :
    (fiveBrackets i).valid fivePolynomial = true := by
  fin_cases i <;> decide +kernel

theorem five_ordered : ∀ i j : Fin 5, i < j →
    (fiveBrackets i).interval.hi < (fiveBrackets j).interval.lo := by
  decide +kernel

theorem five_interior : ∀ i : Fin 5,
    -1 < (fiveBrackets i).interval.lo ∧ (fiveBrackets i).interval.hi < 1 := by
  decide +kernel

theorem five_monic : (realPolynomial fivePolynomial).Monic := by
  norm_num [realPolynomial, fivePolynomial]
  monicity!

theorem five_degree : (realPolynomial fivePolynomial).natDegree = 5 := by
  norm_num [realPolynomial, fivePolynomial]
  compute_degree!

theorem five_moments (k : ℕ) (hk : k < 5) :
    shiftedMoment fivePolynomial k = 0 := by
  interval_cases k <;> decide +kernel

/-- Positive Gaussian rule with the certified roots in stored-table order. -/
noncomputable def fiveGaussian : Rule 5 :=
  rule (by decide) fivePolynomial fiveBrackets five_valid
    five_ordered five_interior five_monic five_degree five_moments

theorem five_nodes_mem (i : Fin 5) :
    (fiveBrackets i).interval.MemReal (fiveGaussian.nodes i) :=
  nodes_mem fivePolynomial fiveBrackets five_valid i

